\title{Order and entropy of lattices of unit vectors in d dimensions: label-free discovery of unusual local organization in simulated lattices and synthetic images}

\author[a]{Leon Sandler\corref{cor1}}
\cortext[cor1]{Corresponding author. e-mail: sandler.leon@gmail.com; ORCID 0009-0007-4584-808X}
